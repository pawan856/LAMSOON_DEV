    <machineKey validationKey="A217803D1548E76092B5DD507090339172328C32CAD6CF48300ED81E88FCC9E44F8F7F553CC81F676CC580A7FFD103F625BB02DC841DD1E4270BD9196C81D9C6" decryptionKey="3652E287E7C22753BE7678BCF05829C3E78BB87BB00BBF56" validation="SHA1" />
    <authentication mode="Forms">
      <forms name="wmsCookie" loginUrl="default.aspx" defaultUrl="main.aspx" timeout="2880" slidingExpiration="true" cookieless="UseCookies" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <membership configSource="membership.config" />
    <roleManager configSource="roleManager.config" />
    <httpHandlers>
      <add verb="*" path="Reserved.ReportViewerWebControl.axd" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845DCD8080CC91" />
    </httpHandlers>
    <httpRuntime maxRequestLength="40960" requestLengthDiskThreshold="40960" executionTimeout="600" requestValidationMode="2.0" />
    <!--<sessionState mode="SQLServer" sqlCommandTimeout="300" sqlConnectionString="data source=S148-72-22-137\LAMSOONDB;Trusted_Connection=True;" timeout="1200" />-->
    <sessionState mode="InProc" timeout="1200" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add name="Reserved-ReportViewerWebControl-axd" path="Reserved.ReportViewerWebControl.axd" verb="*" type="Microsoft.Reporting.WebForms.HttpHandler" resourceType="Unspecified" preCondition="integratedMode" />
      <add name="ReportViewerWebControlHandler" preCondition="integratedMode" verb="*" path="Reserved.ReportViewerWebControl.axd" type="Microsoft.Reporting.WebForms.HttpHandler, Microsoft.ReportViewer.WebForms, Version=11.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" />
    </handlers>
    <httpErrors errorMode="Detailed" />
