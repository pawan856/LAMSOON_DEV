          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="RO_RPTTableAdapter" GeneratorDataComponentClassName="RO_RPTTableAdapter" Name="RO_RPT" UserDataComponentName="RO_RPTTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="ConnectionString (Web.config)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT        WMS_REPLENISH.RO_RCV_BY, WMS_REPLENISH.RO_CUST_INV_NO, 1 AS C_QTY, WMS_REPLENISH.RO_WH_CODE, WMS_REPLENISH.STORER_CODE, '' AS STORER_MESSER, 
                         WMS_STORER.STO_CONT_PER_ORD AS STORER_ATTN, '' AS STORER_CC, CONVERT(varchar, WMS_REPLENISH.RO_DATE, 103) AS REPORT_DATE, 
                         WMS_REPLENISH.RO_REM, WMS_REPLENISH_D.ROD_DISP_SEQ, WMS_REPLENISH_D.ROD_REF_NO, 
                         WMS_REPLENISH_D.ROD_BATCH_NO AS OLD_BATCH_NO, WMS_REPLENISH_D.ROD_PALLET_NO, WMS_REPLENISH_D.ROD_CARTON_NO, 
                         WMS_REPLENISH_D.ROD_ITM_NAME, WMS_REPLENISH_D.ROD_ITM_CODE, WMS_REPLENISH_D.ROD_UOM, WMS_REPLENISH_D.ROD_PCS_PER_UOM, 
                         WMS_REPLENISH_D.ROD_TOT_PCS AS OLD_TOTAL, WMS_REPLENISH_D.ROD_CBM AS TOT_CBM, WMS_REPLENISH_D.ROD_KG AS TOT_KG, 
                         WMS_REPLENISH_D.ROD_LENGTH, WMS_REPLENISH_D.ROD_WIDTH, WMS_REPLENISH_D.ROD_HEIGHT, WMS_REPLENISH_D.ROD_CBM, 
                         WMS_REPLENISH_D.ROD_KG, '' AS TOTAL_CARTON, 0 AS TOTAL_PALLET, WMS_REPLENISH.RO_REF_NO AS REF_NO, 
                         'From ' + ISNULL(WMS_REPLENISH.RO_DEST, '') AS FROM_DEST, '' AS PRODUCT_TYPE, ISNULL(WMS_REPLENISH_D.ROD_PCS_PER_UOM, 0) 
                         * ISNULL(WMS_REPLENISH_D.ROD_TOT_PCS, 0) AS ROD_TOT_PCS
FROM            WMS_REPLENISH_D INNER JOIN
                         WMS_REPLENISH ON WMS_REPLENISH_D.IMP_CODE = WMS_REPLENISH.IMP_CODE AND 
                         WMS_REPLENISH_D.STORER_CODE = WMS_REPLENISH.STORER_CODE AND WMS_REPLENISH_D.RO_CODE = WMS_REPLENISH.RO_CODE INNER JOIN
                         WMS_STORER ON WMS_REPLENISH.IMP_CODE = WMS_STORER.IMP_CODE AND WMS_REPLENISH.STORER_CODE = WMS_STORER.STORER_CODE
WHERE        (WMS_REPLENISH.IMP_CODE = 'WMS') AND (WMS_REPLENISH.RO_CODE = '000176') AND (WMS_REPLENISH.STORER_CODE = '003')
ORDER BY WMS_REPLENISH_D.ROD_DISP_SEQ, WMS_REPLENISH_D.ROD_SEQ</CommandText>
