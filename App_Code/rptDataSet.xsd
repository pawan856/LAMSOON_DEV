            <MainSource>
              <DbSource ConnectionRef="WMS_DEVConnectionString (Web.config)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>
                      SELECT     dm.STORER_CODE, dm.DO_CODE, dm.DO_ISSUED_BY, to_char(dm.DO_DATE, 'yy/mm/dd') AS do_date, to_char(
                      dm.DO_CONF_DELDATE, 'yy/mm/dd') AS do_conf_deldate, to_char(dm.DO_CONF_DELTIME, 'hh24:mi:ss') AS do_conf_deltime, dm.CUS_NAME,
                      CASE WHEN ISNULL(dm.do_addr1, '') &lt;&gt; '' THEN dm.do_addr1 ELSE '' END + CASE WHEN ISNULL(dm.do_addr2, '') &lt;&gt; '' THEN CHAR(13) + CHAR(10) 
                      + dm.do_addr2 ELSE '' END + CASE WHEN ISNULL(dm.do_addr3, '') &lt;&gt; '' THEN CHAR(13) + CHAR(10) 
                      + dm.do_addr3 ELSE '' END + CASE WHEN ISNULL(dm.do_area_del, '') &lt;&gt; '' THEN CHAR(13) + CHAR(10) 
                      + dm.do_area_del ELSE '' END + CASE WHEN ISNULL(dm.do_region_del, '') 
                      &lt;&gt; '' THEN ' ' + dm.do_region_del ELSE '' END + CASE WHEN ISNULL(dm.do_country_del, '') &lt;&gt; '' THEN CHAR(13) + CHAR(10) 
                      + dm.do_country_del ELSE '' END AS do_addr, dm.DO_CUS_CONT, dm.DO_CUS_CONT_TEL, dm.DO_CUS_REF_NO, dd.DOD_DISP_SEQ, 
                      dd.DOD_ITM_CODE, dd.DOD_ITM_DESC, dd.DOD_QTY, dd.DOD_REM, to_number(ISNULL(dm.DO_TOTL_PALLETS, 0)) AS total_pallet, to_number(
                      ISNULL(dm.DO_TOTL_CARTONS, 0)) AS total_carton, dm.DO_DRIVER, dm.DO_INV_NO, dd.DOD_BATCH_CD, 
                      WMS_VENDOR.VND_NAME
FROM         WMS_DELV_ORDER AS dm INNER JOIN
                      WMS_DELV_ORDER_D AS dd ON dm.IMP_CODE = dd.IMP_CODE AND dm.STORER_CODE = dd.STORER_CODE AND 
                      dm.DO_CODE = dd.DO_CODE INNER JOIN
                      WMS_VENDOR ON dm.IMP_CODE = WMS_VENDOR.IMP_CODE AND dd.STORER_CODE = WMS_VENDOR.STORER_CODE AND 
                      dd.DOD_VND_CODE = WMS_VENDOR.VND_CODE
ORDER BY dd.DOD_DISP_SEQ</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
