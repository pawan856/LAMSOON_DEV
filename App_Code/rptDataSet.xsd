                    <CommandText>SELECT     pd.IMP_CODE, pd.STORER_CODE, pd.DO_CODE, pd.PAD_PACK_NO, pd.PAD_DISPLAY_SEQ, pd.PAD_PALLET_NO, pd.PAD_PACK_TYPE, 
                      pd.PAD_TOTL_PACKS, pd.PAD_UOM, pd.PAD_CARTON_NO, pd.PAD_PACK_KEY, pd.PAD_ITM_CODE, pd.PAD_VND_CODE, pd.PAD_BATCH_NO, 
