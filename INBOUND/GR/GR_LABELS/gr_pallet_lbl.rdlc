<?xml version="1.0" encoding="utf-8"?>
<Report xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition">
  <DataSources>
    <DataSource Name="SQLOLEDB_CMS_DEV_WMS_DEV">
      <ConnectionProperties>
        <DataProvider>OLEDB</DataProvider>
        <ConnectString>Provider=SQLOLEDB;Data Source=CMS_DEV;Persist Security Info=True;Password=adm123;User ID=sa;Initial Catalog=WMS_DEV</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>46facd51-e8f6-446a-b5c2-44a1f15ef5e1</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="rptDataSet_gr_pallet_label">
      <Fields>
        <Field Name="storer_code">
          <DataField>storer_code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_pallet_no">
          <DataField>grd_pallet_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_ref_no">
          <DataField>grd_ref_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gr_date">
          <DataField>gr_date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gr_destination">
          <DataField>gr_destination</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_batch_no">
          <DataField>grd_batch_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_stocktype">
          <DataField>grd_stocktype</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_itm_code">
          <DataField>grd_itm_code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_itm_name">
          <DataField>grd_itm_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_rcv_qty">
          <DataField>grd_rcv_qty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="total_carton">
          <DataField>total_carton</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="gr_track_no">
          <DataField>gr_track_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>SQLOLEDB_CMS_DEV_WMS_DEV</DataSourceName>
        <CommandText>select gm.storer_code, gd.grd_pallet_no, gd.grd_ref_no, convert(varchar, gm.gr_date, 111) as gr_date, gm.gr_destination,  
                    gd.grd_batch_no, gd.grd_stocktype, gd.grd_itm_code, gd.grd_itm_name, ISNULL(convert(varchar, gd.grd_rcv_qty), 0) as grd_rcv_qty,  
                        (select sum(case when ISNULL(GRD_CARTON_NO,'') &lt;&gt; '' then 1 else 0 end) from  
                            (select distinct grd_carton_no from wms_goodsrcv, wms_goodsrcv_d  
                            where wms_goodsrcv.imp_code = wms_goodsrcv_d.imp_code  
                            and wms_goodsrcv.storer_code = wms_goodsrcv_d.storer_code  
                            and wms_goodsrcv.gr_code = wms_goodsrcv_d.gr_code  
                            and wms_goodsrcv.imp_code = gm.imp_code  
                            and wms_goodsrcv.gr_code= gm.gr_code  
                            and wms_goodsrcv.storer_code= gm.storer_code  
                            and wms_goodsrcv_d.grd_pallet_no= gd.grd_pallet_no)  
                        temp) as total_carton  
                    from wms_goodsrcv gm, wms_goodsrcv_d gd where  
                    gm.imp_code = gd.imp_code and  
                    gm.storer_code = gd.storer_code And  
                    gm.gr_code = gd.gr_code  
                    order by gd.grd_pallet_no </CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>rptDataSet</rd:DataSetName>
        <rd:TableName>gr_pallet_label</rd:TableName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterName>gr_pallet_labelTableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
