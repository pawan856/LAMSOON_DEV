<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="SQLOLEDB_WMS_DEV_WMS_DEV">
      <ConnectionProperties>
        <DataProvider>OLEDB</DataProvider>
        <ConnectString>Provider=SQLOLEDB;Data Source=WMS_DEV;Persist Security Info=True;Password=adm123;User ID=sa;Initial Catalog=WMS_DEV</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>2e80d580-87eb-42b2-b4e5-b0b6312fc5b7</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="rptDataSet_gr_carton_label">
      <Fields>
        <Field Name="storer_code">
          <DataField>storer_code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_ref_no">
          <DataField>grd_ref_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gr_date">
          <DataField>gr_date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gr_destination">
          <DataField>gr_destination</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_carton_no">
          <DataField>grd_carton_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_itm_code">
          <DataField>grd_itm_code</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_itm_name">
          <DataField>grd_itm_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="grd_rcv_qty">
          <DataField>grd_rcv_qty</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="gr_track_no">
          <DataField>gr_track_no</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>SQLOLEDB_WMS_DEV_WMS_DEV</DataSourceName>
        <CommandText> select gm.storer_code, gd.grd_ref_no,  
                    convert(varchar, gm.gr_date, 111) as gr_date,  
                    gm.gr_destination, gd.grd_carton_no,  
                    gd.grd_itm_code, gd.grd_itm_name,  
                    ISNULL(convert(varchar, gd.grd_rcv_qty), 0) as grd_rcv_qty  
                    from wms_goodsrcv gm, wms_goodsrcv_d gd where  
                    gm.imp_code = gd.imp_code and  
                    gm.storer_code = gd.storer_code and  
                    gm.gr_code = gd.gr_code	</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>rptDataSet</rd:DataSetName>
        <rd:TableName>gr_carton_label</rd:TableName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterName>gr_carton_labelTableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
