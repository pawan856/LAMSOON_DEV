        </Field>
      </Fields>
      <Query>
        <DataSourceName>WMS_DEVConnectionString</DataSourceName>
        <CommandText>SELECT     pd.IMP_CODE, pd.STORER_CODE, pd.DO_CODE, pd.PAD_PACK_NO, pd.PAD_DISPLAY_SEQ, pd.PAD_PALLET_NO, pd.PAD_PACK_TYPE, 
                      pd.PAD_TOTL_PACKS, pd.PAD_UOM, pd.PAD_CARTON_NO, pd.PAD_PACK_KEY, pd.PAD_ITM_CODE, pd.PAD_VND_CODE, pd.PAD_BATCH_NO, 
                      pd.PAD_QTY, pd.PAD_LENGTH, pd.PAD_WIDTH, pd.PAD_HEIGHT, pd.PAD_REF_NO, pd.PAD_PACK_BY, pd.PAD_NET_WEIGHT, 
                      pd.PAD_GROSS_WEIGHT, pd.PAD_MIN_PACKING, pd.SYS_CB, pd.SYS_CD, pd.SYS_LUB, pd.SYS_LUD, DO.CUS_NAME, DO.DO_DATE, 
                      d.AITM_NET_WEIGHT, d.AITM_GROSS_WEIGHT, d.AITM_ORIGIN, 0 AS tot_qty, DO_PACK_LABEL_1,
DO_PACK_LABEL_2,
DO_PACK_LABEL_3,
DO_PACK_LABEL_QTY_1,
DO_PACK_LABEL_QTY_2,	
DO_PACK_LABEL_QTY_3,
DO_INV_NO, '' as storer_name, '' as ctn_qty
FROM         WMS_DELV_ORDER AS DO INNER JOIN
                      WMS_DO_PACKING_D AS pd ON DO.IMP_CODE = pd.IMP_CODE AND DO.STORER_CODE = pd.STORER_CODE AND 
                      DO.DO_CODE = pd.DO_CODE LEFT OUTER JOIN
                      WMS_ITEM AS m ON pd.IMP_CODE = m.IMP_CODE AND pd.STORER_CODE = m.STORER_CODE AND pd.PAD_PACK_KEY = m.PACK_KEY AND 
                      pd.PAD_ITM_CODE = m.ITM_CODE LEFT OUTER JOIN
                      WMS_ALT_VEND_ITEM AS d ON m.IMP_CODE = d.IMP_CODE AND m.STORER_CODE = d.STORER_CODE AND m.ITM_CODE = d.ITM_CODE AND 
                      m.PACK_KEY = d.PACK_KEY AND pd.PAD_VND_CODE = d.VND_CODE</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>rptDataSet</rd:DataSetName>
        <rd:TableName>packing_list</rd:TableName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterName>packing_listTableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
