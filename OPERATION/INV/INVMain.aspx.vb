    Private Function customizectrl(ByVal ctl As Control, ByRef ctrlArrayList As ArrayList) As Boolean
        customizectrl = False

        Select Case ctl.ID
            Case "invd_rate"
                CType(ctl, TextBox).Enabled = True
                CType(ctl, TextBox).ReadOnly = False
                CType(ctl, TextBox).BorderWidth = Nothing
                CType(ctl, TextBox).BackColor = Nothing
                customizectrl = True
            Case "invd_qty" '"dsp_invd_amount"
                'CType(ctl, TextBox).Enabled = False
                CType(ctl, TextBox).ReadOnly = True
                CType(ctl, TextBox).BorderWidth = 0
                CType(ctl, TextBox).BackColor = Drawing.Color.Transparent
                customizectrl = True
        End Select
    End Function

    Private Function page_customizectrl(ByVal ctl As Control) As Boolean
        page_customizectrl = False

        Select Case ctl.ID
            Case "saveBtn2", "saveBtn1", "genInvBtn"
                CType(ctl, Button).Enabled = True
                page_customizectrl = True
            Case "INVH_DATE", "INVH_FR_MONTH", "INVH_TO_MONTH", _
                    "INVH_GEN_BY", "INVH_ADDR1", "INVH_ADDR2", _
                    "INVH_ADDR3", "INVH_ATTN", "INVH_TEL", "INVH_FAX"
                CType(ctl, TextBox).Enabled = True
                CType(ctl, TextBox).ReadOnly = False
                CType(ctl, TextBox).BorderWidth = Nothing
                CType(ctl, TextBox).BackColor = Nothing
                page_customizectrl = True
            Case "img_INVH_DATE", "img_INVH_FR_MONTH", "img_INVH_TO_MONTH"
                CType(ctl, ImageButton).Visible = True
                page_customizectrl = True
            Case "CUS_CODE"
                CType(ctl, DropDownList).Enabled = True
                page_customizectrl = True
        End Select
    End Function

