    Protected Sub genInvBtn_Click(ByVal sender As Object, ByVal e As System.EventArgs) Handles genInvBtn.Click
        Dim frmdate As String = INVH_FR_MONTH.Text.Trim
        Dim todate As String = INVH_TO_MONTH.Text.Trim

        ViewState("genbeforesave") = False
        ViewState("old_fr") = frmdate
        ViewState("old_to") = todate

        If validateAll() Then
            If Session("pagemode") = "N" Then
                dt = getItemsDataTbl(dt, "", frmdate, todate)
                genItemsDetail(dt, "", frmdate, todate)
                genLocDetail(dt, "", frmdate, todate)

                If dt.Rows.Count > 0 Then
                    Dim sortDt As DataTable
                    sortDt = dt.Copy

                    Dim foundRows As DataRow() = sortDt.Select("", "INV_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")

                    dt.Rows.Clear()

                    For i As Integer = 0 To foundRows.Count - 1
                        foundRows(i).Item("INVD_SEQ") = i + 1
                        foundRows(i).Item("INVD_DISPLAY_SEQ") = i + 1
                        dt.ImportRow(foundRows(i))
                    Next

                    dt.AcceptChanges()

                    Dim tempRows As DataRow() = dt.Select("INVD_DISPLAY_GRP='DEFAULT' OR INVD_DISPLAY_GRP='ANY'", "INV_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                    Dim tempDT As New DataTable

                    tempDT = dt.Copy
                    tempDT.Rows.Clear()

                    For x As Integer = 0 To tempRows.Count - 1
                        tempDT.ImportRow(tempRows(x))
                    Next

                    GridView1.DataSource = tempDT

                    ViewState("currentdt") = tempDT
                    currentdt = tempDT

                    sortDt.Dispose()
                Else
                    GridView1.DataSource = Nothing
                End If
            Else
                Dim detaildt As New DataTable

                For i As Integer = 0 To dt.Rows.Count - 1
                    'GridView1.Rows(i).Visible = False
                    dt.Rows(i).Item("mFlag") = "D"
                    dt.AcceptChanges()
                Next

                detaildt = getItemsDataTbl(detaildt, gU.dbEncode(INVH_NO.Text.Trim), frmdate, todate)

                genItemsDetail(detaildt, "", frmdate, todate)

                genLocDetail(detaildt, "", frmdate, todate)

                Dim seq_string As String = "select MAX(CAST(INVD_SEQ AS int))  from WMS_INVOICE_DTL " & _
                                            "where imp_code = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                                            "and storer_code = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                                            "and invh_no = '" & gU.dbEncode(INVH_NO.Text.Trim) & "' "


                Dim gvMAXSEQ As Integer = gU.decodeEmptyCInt(DB.getValueFromSQL(seq_string), 0)

                If detaildt.Rows.Count > 0 Then
                    Dim sortDt As DataTable
                    sortDt = detaildt.Copy

                    Dim foundRows As DataRow() = sortDt.Select("", "INV_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")

                    detaildt.Rows.Clear()

                    For i As Integer = 0 To foundRows.Count - 1
                        foundRows(i).Item("INVD_SEQ") = gvMAXSEQ + 1
                        foundRows(i).Item("INVD_DISPLAY_SEQ") = i + 1
                        detaildt.ImportRow(foundRows(i))

                        gvMAXSEQ += 1
                    Next

                    dt.Merge(detaildt, True, MissingSchemaAction.Ignore)

                    Dim tempRows As DataRow() = detaildt.Select("INVD_DISPLAY_GRP='DEFAULT' OR INVD_DISPLAY_GRP='ANY'", "INV_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                    Dim tempDT As New DataTable

                    tempDT = detaildt.Copy
                    tempDT.Rows.Clear()

                    For x As Integer = 0 To tempRows.Count - 1
                        tempDT.ImportRow(tempRows(x))
                    Next

                    GridView1.DataSource = tempDT
                    ViewState("currentdt") = tempDT
                    currentdt = tempDT
                Else
                    GridView1.DataSource = Nothing
                End If
            End If

            ViewState("listmode") = "D"
            listmode.SelectedValue = "DEFAULT"
            ViewState("dt") = dt

            If dt.Rows.Count > 0 Then
                ViewState("savebefore") = True
            End If

            GridView1.DataBind()

            ar.sec_viewMode = "Y"

            ar.hideForm(Me, editMode, AddressOf page_customizectrl, AddressOf customizectrl)
            ar.hideGVForStorer(GridView1, STORER_CODE.Text, "INV", "WMS_INVOICE_DTL")
        End If
    End Sub

