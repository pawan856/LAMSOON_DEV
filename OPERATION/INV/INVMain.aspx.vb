    Protected Sub BindGV()
        Dim SQLString As String = ""
        Dim dt As New DataTable
        Dim SCString As String = "WHERE"
        Dim WhereStr As String = ""
        Dim pk_code As String = ""
        Dim storerCode As String

        REM **********************
        REM Modify Here
        REM Primary Key Session
        If ViewState("INVH_NO") <> "" Then
            pk_code = ViewState("INVH_NO")
        Else
            pk_code = Server.UrlDecode(Request("INVH_NO"))
        End If

        If ViewState("STORER_CODE") <> "" Then
            storerCode = ViewState("STORER_CODE")
        Else
            storerCode = Server.UrlDecode(Request("STORER_CODE"))
        End If
        REM **********************

        If Session("pagemode") = "N" Then
            REM **********************
            REM Modify Here
            INVH_NO.ForeColor = Drawing.Color.Red

            REM **********************
            uiFun.load_dropdown(CUS_CODE, "select CUS_CODE, CUS_NAME from wms_customer where " & _
                              "storer_code = '" & STORER_CODE.SelectedValue & "' " & _
                            "and imp_code = '" & Session("IMP_CODE") & "' " & _
                            "ORDER BY 2", "CUS_CODE", "CUS_CODE", , Session("gSelectLabel"))
        Else
            REM **********************
            REM Modify Here
            REM Generate Data Table from Header
            SQLString = "select *,convert(varchar,INVH_DATE,103) as INVH_DATE1, convert(varchar,INVH_FR_MONTH,103) as INVH_FR_MONTH1,convert(varchar,INVH_TO_MONTH,103) as INVH_TO_MONTH1 from wms_invoice_hd " & _
                        "where wms_invoice_hd.invh_no = '" & gU.dbEncode(pk_code) & "' " & _
                        "and wms_invoice_hd.imp_code = '" & Session("IMP_CODE") & "' " & _
                        "and wms_invoice_hd.storer_code = '" & gU.dbEncode(storerCode) & "' "

            dt = gDB.getDataTable(SQLString)

            If dt.Rows.Count > 0 Then

                STORER_CODE.SelectedValue = dt.Rows(0).Item("STORER_CODE").ToString
                h_STORER_CODE.Value = dt.Rows(0).Item("STORER_CODE").ToString
                INVH_NO.Text = dt.Rows(0).Item("INVH_NO").ToString
                h_INVH_NO.Value = dt.Rows(0).Item("INVH_NO").ToString
                INVH_DATE.Text = dt.Rows(0).Item("INVH_DATE1").ToString
                INVH_FR_MONTH.Text = dt.Rows(0).Item("INVH_FR_MONTH1").ToString
                ViewState("old_fr") = INVH_FR_MONTH.Text
                INVH_TO_MONTH.Text = dt.Rows(0).Item("INVH_TO_MONTH1").ToString
                ViewState("old_to") = INVH_TO_MONTH.Text
                INVH_GEN_BY.Text = dt.Rows(0).Item("INVH_GEN_BY").ToString

                If dt.Rows(0).Item("CUS_CODE").ToString <> "" Then CUS_CODE.SelectedValue = dt.Rows(0).Item("CUS_CODE").ToString

                CUS_NAME.Text = dt.Rows(0).Item("CUS_NAME").ToString
                INVH_ADDR1.Text = dt.Rows(0).Item("INVH_ADDR1").ToString
                INVH_ADDR2.Text = dt.Rows(0).Item("INVH_ADDR2").ToString
                INVH_ADDR3.Text = dt.Rows(0).Item("INVH_ADDR3").ToString
                INVH_ATTN.Text = dt.Rows(0).Item("INVH_ATTN").ToString
                INVH_TEL.Text = dt.Rows(0).Item("INVH_TEL").ToString
                INVH_FAX.Text = dt.Rows(0).Item("INVH_FAX").ToString

                sys_cb.Text = dt.Rows(0).Item("sys_cb").ToString
                sys_lub.Text = dt.Rows(0).Item("sys_lub").ToString
                sys_cd.Text = cU.chgToFullDF(dt.Rows(0).Item("sys_cd").ToString)
                sys_lud.Text = cU.chgToFullDF(dt.Rows(0).Item("sys_lud").ToString)

                If dt.Rows(0).Item("STORER_CODE").ToString = "" Then
                    uiFun.load_dropdown(STORER_CODE, "SELECT STORER_CODE, STO_SHORTNAME FROM WMS_STORER ORDER BY 2", "STORER_CODE", "STO_SHORTNAME", , Session("gSelectLabel"))
                Else
                    uiFun.load_dropdown(STORER_CODE, "SELECT STORER_CODE, STO_SHORTNAME FROM WMS_STORER WHERE STORER_CODE = '" & gU.dbEncode(dt.Rows(0).Item("storer_code").ToString) & "' ORDER BY 2", "STORER_CODE", "STO_SHORTNAME", , , , True)
                End If

                uiFun.load_dropdown(CUS_CODE, "select CUS_CODE, CUS_NAME from wms_customer where " & _
                              "storer_code = '" & STORER_CODE.SelectedValue & "' " & _
                              "and imp_code = '" & Session("IMP_CODE") & "' " & _
                              "ORDER BY 2", "CUS_CODE", "CUS_CODE", , Session("gSelectLabel"))


                If dt.Rows(0).Item("CUS_CODE").ToString <> "" Then CUS_CODE.SelectedValue = dt.Rows(0).Item("CUS_CODE").ToString

                If INVH_NO.Text <> "" Then
                    'AD_CODE.ReadOnly = True
                    'AD_CODE.BorderWidth = 0
                    INVH_NO.BackColor = Drawing.Color.Transparent
                    ViewState("INVH_NO") = INVH_NO.Text
                End If


                If INVH_GEN_BY.Text <> "" Then
                    INVH_GEN_BY.ReadOnly = True
                    INVH_GEN_BY.BorderWidth = 0
                    INVH_GEN_BY.BackColor = Drawing.Color.Transparent
                End If

                REM **********************
            End If
            REM **********************
        End If
        REM **********************
        REM Modify Here
        REM Generate Data Table from Detail
        SQLString = "SELECT " & _
                    "IMP_CODE, " & _
                    "STORER_CODE, " & _
                    "INVH_NO, " & _
                    "INVD_SEQ, " & _
                    "INVD_DISPLAY_SEQ, " & _
                    "INVD_ITM_CODE, " & _
                    "INVD_PACK_KEY, " & _
                    "INVD_LOC, " & _
                    "INVD_TYPE, " & _
                    "INVD_DESC, " & _
                    "convert(varchar,INVD_TX_DATE,103) as INVD_TX_DATE, " & _
                    "INVD_UNIT, " & _
                    "INVD_RATE, " & _
                    "INVD_CURR, " & _
                    "INVD_QTY, " & _
                    "INVD_AMOUNT, " & _
                    "INVD_DISPLAY_GRP, " & _
                    "INV_RATE_SEQ, " & _
                    "SYS_LUB, " & _
                    "SYS_LUD, " & _
                    "SYS_CD, " & _
                    "SYS_CB, " & _
                    "'U' as mFlag, '' as INV_DISPLAY_SEQ " & _
                    "from wms_invoice_dtl " & _
                    "where " & _
                    "wms_invoice_dtl.invh_no = '" & gU.dbEncode(pk_code) & "' " & _
                    "and wms_invoice_dtl.storer_code = '" & gU.dbEncode(storerCode) & "' " & _
                    "and wms_invoice_dtl.imp_code = '" & Session("IMP_CODE") & "'"

        SQLString = SQLString & " order by wms_invoice_dtl.invd_display_seq"
        REM **********************
        dt = gDB.getDataTable(SQLString)
        If dt.Rows.Count > 0 Then
            'GridView1.DataSource = dt
            Dim tempRows As DataRow()
            Dim tempDT As New DataTable

            Select Case ViewState("listmode")
                Case "D"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='DEFAULT' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                Case "I"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='ITEM' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                Case "L"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='LOCATION' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                Case Else
                    tempRows = dt.Select("INVD_DISPLAY_GRP='DEFAULT' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
            End Select

            tempDT = dt.Copy
            tempDT.Rows.Clear()

            For x As Integer = 0 To tempRows.Count - 1
                tempDT.ImportRow(tempRows(x))
            Next

            GridView1.DataSource = tempDT
            ViewState("currentdt") = tempDT
            currentdt = tempDT
        Else
            GridView1.DataSource = Nothing
        End If

        ViewState("dt") = dt
        GridView1.DataBind()

        REM **********************
    End Sub

