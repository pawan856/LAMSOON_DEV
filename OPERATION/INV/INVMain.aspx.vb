                   "AND IR.IMP_CODE = WMS_INV_RATES.IMP_CODE " & _
                   "AND IR.STORER_CODE = WMS_INV_RATES.STORER_CODE " & _
                   "AND IR.INVR_TYPE = WMS_INV_RATES.INVR_TYPE " & _
                   "AND Getdate() >= IR.INVR_EFF_DATE " & _
                   "AND Getdate() < DATEADD(Day, 1, IR.INVR_EXP_DATE)) " & _
                   "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                   "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_INV_RATES.STORER_CODE, " & _
                   "WMS_INV_RATES.INVR_TYPE,WMS_INV_RATES.INVR_DESC, " & _
                   "BAL_TX.ITM_CODE,BAL_TX.PACK_KEY, BAL_TX.ITX_DATE, BAL_TX.ITX_LOC, " & _
                   "BAL_TX.ITX_BAL_KG, WMS_INV_RATES.INVR_CURR " & _
                   "UNION " & _
                   "SELECT '' AS INV_RATE_SEQ, WMS_INV_RATES.IMP_CODE, " & _
                   "'" & inv_no & "' AS INVH_NO, 'ITEM' AS INVD_DISPLAY_GRP, " & _
                   "WMS_INV_RATES.STORER_CODE, " & _
                   "'' AS INVD_SEQ, " & _
                   "MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INVD_DISPLAY_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INV_DISPLAY_SEQ, " & _
                   "WMS_INV_RATES.INVR_TYPE AS INVD_TYPE, WMS_INV_RATES.INVR_DESC AS INVD_DESC, " & _
                   "BAL_TX.ITM_CODE AS INVD_ITM_CODE, BAL_TX.PACK_KEY AS INVD_PACK_KEY, BAL_TX.ITX_LOC AS INVD_LOC, " & _
                   "BAL_TX.ITX_DATE as INVD_TX_DATE, " & _
                   "MAX(WMS_INV_RATES.INVR_UNIT) AS INVD_UNIT, " & _
                   "MAX(WMS_INV_RATES.INVR_RATE) AS INVD_RATE, " & _
                   "BAL_TX.ITX_BAL_KG AS INVD_QTY, " & _
                   "MAX(WMS_INV_RATES.INVR_RATE) * BAL_TX.ITX_BAL_KG AS INVD_AMOUNT, " & _
                   "WMS_INV_RATES.INVR_CURR AS INVD_CURR, 'N' AS mFlag " & _
                   "FROM WMS_INV_RATES LEFT OUTER JOIN " & _
                   "(SELECT IMP_CODE, STORER_CODE, ITM_CODE, PACK_KEY, convert(varchar,ITX_DATE,103) as ITX_DATE, ITX_BAL_KG, ITX_LOC " & _
                   "FROM WMS_ITEM_LOC_BAL_TX WHERE " & _
                   "WMS_ITEM_LOC_BAL_TX.IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                   "AND WMS_ITEM_LOC_BAL_TX.STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                   "AND convert(varchar, ITX_DATE,103) = (SELECT convert(varchar, MAX(ITX_DATE),103) from WMS_ITEM_LOC_BAL_TX WHERE ITX_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                   "AND ITX_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) AND IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                   "AND STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                   "AND ITX_BAL_KG > 0)) BAL_TX " & _
                   "ON WMS_INV_RATES.IMP_CODE = BAL_TX.IMP_CODE AND " & _
                       "WMS_INV_RATES.STORER_CODE = BAL_TX.STORER_CODE " & _
                   "WHERE WMS_INV_RATES.INVR_TYPE = 'BYKGAE' " & _
                   "AND Getdate() >= WMS_INV_RATES.INVR_EFF_DATE " & _
                   "AND Getdate() < DATEADD(Day, 1, WMS_INV_RATES.INVR_EXP_DATE) " & _
                   "AND BAL_TX.ITM_CODE IS NOT NULL " & _
                   "AND BAL_TX.ITX_BAL_KG > 0 " & _
                   "AND WMS_INV_RATES.INVR_LOC = BAL_TX.ITX_LOC " & _
                   "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                   "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_INV_RATES.STORER_CODE, " & _
                   "WMS_INV_RATES.INVR_TYPE,WMS_INV_RATES.INVR_DESC, " & _
                   "BAL_TX.ITM_CODE,BAL_TX.PACK_KEY, BAL_TX.ITX_DATE, BAL_TX.ITX_LOC, " & _
                   "BAL_TX.ITX_BAL_KG, WMS_INV_RATES.INVR_CURR " & _
                   "ORDER BY 8"

        byKGAE = gDB.getDataTable(byKGAESQL)

        inCBMSQL = "SELECT '' AS INV_RATE_SEQ, WMS_INV_RATES.IMP_CODE, " & _
                    "'" & inv_no & "' AS INVH_NO, 'ITEM' AS INVD_DISPLAY_GRP, " & _
                    "WMS_GOODSRCV.STORER_CODE, " & _
                    "'' AS INVD_SEQ, " & _
                    "MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INVD_DISPLAY_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INV_DISPLAY_SEQ, " & _
                    "WMS_INV_RATES.INVR_TYPE AS INVD_TYPE, " & _
                    "WMS_INV_RATES.INVR_DESC AS INVD_DESC, WMS_GOODSRCV.GR_CODE AS INVD_ITM_CODE, " & _
                    "'' AS INVD_PACK_KEY, '' as INVD_LOC, " & _
                    "convert(varchar, GR_POSTED_DATE,103) AS INVD_TX_DATE, " & _
                    "MAX(WMS_INV_RATES.INVR_UNIT) AS INVD_UNIT, " & _
                    "MAX(WMS_INV_RATES.INVR_RATE) AS INVD_RATE, " & _
                    "SUM(WMS_GOODSRCV_D.GRD_CBM) AS INVD_QTY, MAX(WMS_INV_RATES.INVR_RATE) * SUM(WMS_GOODSRCV_D.GRD_CBM) AS INVD_AMOUNT, " & _
                    "WMS_INV_RATES.INVR_CURR AS INVD_CURR, 'N' AS mFlag " & _
                    "FROM WMS_GOODSRCV INNER JOIN WMS_GOODSRCV_D ON " & _
                    "WMS_GOODSRCV.IMP_CODE = WMS_GOODSRCV_D.IMP_CODE AND " & _
                    "WMS_GOODSRCV.GR_CODE = WMS_GOODSRCV_D.GR_CODE " & _
                    "CROSS JOIN WMS_INV_RATES " & _
                    "WHERE GR_STATUS = 'POSTED' " & _
                    "AND WMS_GOODSRCV.IMP_CODE = WMS_INV_RATES.IMP_CODE " & _
                    "AND WMS_GOODSRCV.STORER_CODE = WMS_INV_RATES.STORER_CODE " & _
                    "AND WMS_GOODSRCV.IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                    "AND WMS_GOODSRCV.STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                    "AND GR_POSTED_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                    "AND GR_POSTED_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
                    "AND WMS_INV_RATES.INVR_TYPE = 'INCBM' " & _
                    "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                    "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_GOODSRCV.STORER_CODE, " & _
                    "WMS_INV_RATES.INVR_TYPE, WMS_INV_RATES.INVR_DESC, " & _
                    "WMS_GOODSRCV.GR_CODE, WMS_GOODSRCV.GR_POSTED_DATE, WMS_INV_RATES.INVR_CURR " & _
                    "ORDER BY INVD_ITM_CODE"

        inCBM = gDB.getDataTable(inCBMSQL)

        outCBMSQL = "SELECT '' AS INV_RATE_SEQ, WMS_INV_RATES.IMP_CODE, " & _
                    "'" & inv_no & "' AS INVH_NO, 'ITEM' AS INVD_DISPLAY_GRP, " & _
                    "WMS_DELV_ORDER.STORER_CODE, " & _
                    "'' AS INVD_SEQ, " & _
                    "MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INVD_DISPLAY_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INV_DISPLAY_SEQ, " & _
                    "WMS_INV_RATES.INVR_TYPE AS INVD_TYPE, " & _
                    "WMS_INV_RATES.INVR_DESC AS INVD_DESC, WMS_DELV_ORDER.DO_CODE AS INVD_ITM_CODE, " & _
                    "'' AS INVD_PACK_KEY, '' as INVD_LOC, " & _
                    "convert(varchar, WMS_DELV_ORDER.DO_POSTED_DATE,103) AS INVD_TX_DATE, " & _
                    "MAX(WMS_INV_RATES.INVR_UNIT) AS INVD_UNIT, " & _
                    "MAX(WMS_INV_RATES.INVR_RATE) AS INVD_RATE, " & _
                    "SUM(WMS_DELV_ORDER_D.DOD_TOT_CBM) AS INVD_QTY, MAX(WMS_INV_RATES.INVR_RATE) * SUM(WMS_DELV_ORDER_D.DOD_TOT_CBM) AS INVD_AMOUNT, " & _
                    "WMS_INV_RATES.INVR_CURR AS INVD_CURR, 'N' AS mFlag " & _
                    "FROM WMS_DELV_ORDER INNER JOIN WMS_DELV_ORDER_D ON " & _
                    "WMS_DELV_ORDER.IMP_CODE = WMS_DELV_ORDER_D.IMP_CODE AND " & _
                    "WMS_DELV_ORDER.DO_CODE = WMS_DELV_ORDER_D.DO_CODE " & _
                    "CROSS JOIN WMS_INV_RATES " & _
                    "WHERE DO_STATUS = 'POSTED' " & _
                    "AND WMS_DELV_ORDER.IMP_CODE = WMS_INV_RATES.IMP_CODE " & _
                    "AND WMS_DELV_ORDER.STORER_CODE = WMS_INV_RATES.STORER_CODE " & _
                    "AND WMS_DELV_ORDER.IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                    "AND WMS_DELV_ORDER.STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                    "AND DO_POSTED_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                    "AND DO_POSTED_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
                    "AND WMS_INV_RATES.INVR_TYPE = 'OUTCBM' " & _
                    "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                    "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_DELV_ORDER.STORER_CODE, " & _
                    "WMS_INV_RATES.INVR_TYPE, WMS_INV_RATES.INVR_DESC, " & _
                    "WMS_DELV_ORDER.DO_CODE, WMS_DELV_ORDER.DO_POSTED_DATE, WMS_INV_RATES.INVR_CURR " & _
                    "ORDER BY INVD_ITM_CODE"

        outCBM = gDB.getDataTable(outCBMSQL)

        itmDT.Merge(byCBMKG, True, MissingSchemaAction.Ignore)
        itmDT.Merge(byIN, True, MissingSchemaAction.Ignore)
        itmDT.Merge(byOUT, True, MissingSchemaAction.Ignore)
        itmDT.Merge(byCBMAS, True, MissingSchemaAction.Ignore)
        itmDT.Merge(byCBMAE, True, MissingSchemaAction.Ignore)
        itmDT.Merge(byKGAS, True, MissingSchemaAction.Ignore)
        itmDT.Merge(byKGAE, True, MissingSchemaAction.Ignore)
        itmDT.Merge(inCBM, True, MissingSchemaAction.Ignore)
        itmDT.Merge(outCBM, True, MissingSchemaAction.Ignore)

        itmDT.AcceptChanges()
    End Sub

    Private Sub genLocDetail(ByRef locDT As DataTable, ByVal inv_no As String, ByVal frm_date As String, ByVal to_date As String)
        Dim byCBMKGSQL As String = ""
        Dim byINSQL As String = ""
        Dim byOUTSQL As String = ""
        Dim byCBMASSQL As String = ""
        Dim byCBMAESQL As String = ""
        Dim byKGASSQL As String = ""
        Dim byKGAESQL As String = ""
        Dim byINCBMSQL As String = ""
        Dim byOUTCBMSQL As String = ""

        Dim byCBMKG As New DataTable
        Dim byIN As New DataTable
        Dim byOUT As New DataTable
        Dim byCBMAS As New DataTable
        Dim byCBMAE As New DataTable
        Dim byKGAS As New DataTable
        Dim byKGAE As New DataTable

        Dim inCbmDT As New DataTable
        Dim outCbmDT As New DataTable
        Dim incbmsumDT As New DataTable
        Dim outcbmsumDT As New DataTable

        byCBMKGSQL = "SELECT '' AS INV_RATE_SEQ, WMS_INV_RATES.IMP_CODE, '" & inv_no & "' AS INVH_NO, " & _
                    "'LOCATION' AS INVD_DISPLAY_GRP, WMS_INV_RATES.STORER_CODE, '' AS INVD_SEQ, " & _
                    "MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INVD_DISPLAY_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INV_DISPLAY_SEQ, WMS_INV_RATES.INVR_TYPE AS INVD_TYPE, " & _
                    "ISNULL((WMS_INV_RATES.INVR_DESC+' '+(SELECT '('+convert(varchar, MIN(ITX_DATE),103)+' - '+convert(varchar, MAX(ITX_DATE),103)+')' " & _
                    "FROM WMS_ITEM_LOC_BAL_TX WHERE " & _
                    "imp_code = WMS_INV_RATES.IMP_CODE " & _
                    "AND STORER_CODE = WMS_INV_RATES.STORER_CODE " & _
                    "AND ITX_DATE >= MIN(BAL_TX.ITX_DATE) " & _
                    "AND ITX_DATE < DATEADD(Day, 1, MAX(BAL_TX.ITX_DATE)) " & _
                    "AND ITM_CODE IS NOT NULL " & _
                    "AND CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN ITX_BAL_CBM ELSE " & _
                        "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN ITX_BAL_KG END END > 0 " & _
                    "AND NOT EXISTS (select 1 from WMS_INV_RATES IR " & _
                      "where IR.INVR_LOC = ITX_LOC " & _
                      "AND IR.IMP_CODE = WMS_INV_RATES.IMP_CODE " & _
                      "AND IR.STORER_CODE = WMS_INV_RATES.STORER_CODE " & _
                      "AND IR.INVR_TYPE = WMS_INV_RATES.INVR_TYPE " & _
                      "AND Getdate() >= IR.INVR_EFF_DATE " & _
                      "AND Getdate() < DATEADD(Day, 1, IR.INVR_EXP_DATE )))),WMS_INV_RATES.INVR_DESC) AS INVD_DESC, " & _
                    "'' AS INVD_ITM_CODE, '' AS INVD_PACK_KEY, WMS_INV_RATES.INVR_LOC AS INVD_LOC, " & _
                    "null as INVD_TX_DATE, " & _
                    "MAX(WMS_INV_RATES.INVR_UNIT) AS INVD_UNIT, " & _
                    "MAX(WMS_INV_RATES.INVR_RATE) AS INVD_RATE, " & _
                    "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN SUM(BAL_TX.ITX_BAL_CBM) ELSE " & _
                    "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN SUM(BAL_TX.ITX_BAL_KG) END END AS INVD_QTY, " & _
                    "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN MAX(WMS_INV_RATES.INVR_RATE) * SUM(BAL_TX.ITX_BAL_CBM) ELSE " & _
                    "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN MAX(WMS_INV_RATES.INVR_RATE) * SUM(BAL_TX.ITX_BAL_KG) END END AS INVD_AMOUNT, " & _
                    "WMS_INV_RATES.INVR_CURR AS INVD_CURR, 'N' AS mFlag " & _
                    "FROM WMS_INV_RATES LEFT OUTER JOIN " & _
                        "(SELECT IMP_CODE, STORER_CODE, ITX_LOC, ITX_DATE, SUM(ITX_BAL_CBM) AS ITX_BAL_CBM, SUM(ITX_BAL_KG) AS ITX_BAL_KG " & _
                            "FROM WMS_ITEM_LOC_BAL_TX " & _
                            "WHERE ITM_CODE IS NOT NULL " & _
                            "GROUP BY IMP_CODE, STORER_CODE, ITX_LOC, ITX_DATE) BAL_TX " & _
                    "ON WMS_INV_RATES.IMP_CODE = BAL_TX.IMP_CODE " & _
                    "AND WMS_INV_RATES.STORER_CODE = BAL_TX.STORER_CODE " & _
                    "WHERE WMS_INV_RATES.INVR_TYPE IN ('BYCBM', 'BYWGT') " & _
                    "AND Getdate() >= WMS_INV_RATES.INVR_EFF_DATE " & _
                    "AND Getdate() < DATEADD(Day, 1, WMS_INV_RATES.INVR_EXP_DATE) " & _
                    "AND WMS_INV_RATES.INVR_LOC = 'ALL' " & _
                    "AND CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN BAL_TX.ITX_BAL_CBM ELSE " & _
                        "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN BAL_TX.ITX_BAL_KG END END > 0 " & _
                    "AND NOT EXISTS (select 1 from WMS_INV_RATES IR " & _
                      "where IR.INVR_LOC = BAL_TX.ITX_LOC " & _
                      "AND IR.IMP_CODE = WMS_INV_RATES.IMP_CODE " & _
                      "AND IR.STORER_CODE = WMS_INV_RATES.STORER_CODE " & _
                      "AND IR.INVR_TYPE = WMS_INV_RATES.INVR_TYPE " & _
                      "AND Getdate() >= IR.INVR_EFF_DATE " & _
                      "AND Getdate() < DATEADD(Day, 1, IR.INVR_EXP_DATE)) " & _
                    "AND WMS_INV_RATES.IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                    "AND WMS_INV_RATES.STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                    "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                    "AND BAL_TX.ITX_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                    "AND BAL_TX.ITX_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
                    "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_INV_RATES.STORER_CODE, " & _
                    "WMS_INV_RATES.INVR_TYPE,WMS_INV_RATES.INVR_DESC, WMS_INV_RATES.INVR_CURR, " & _
                    "WMS_INV_RATES.INVR_LOC " & _
                    "UNION " & _
                    "SELECT '' AS INV_RATE_SEQ, WMS_INV_RATES.IMP_CODE, '' AS INVH_NO, " & _
                    "'LOCATION' AS INVD_DISPLAY_GRP, WMS_INV_RATES.STORER_CODE, " & _
                    "'' AS INVD_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INVD_DISPLAY_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INV_DISPLAY_SEQ, " & _
                    "WMS_INV_RATES.INVR_TYPE AS INVD_TYPE, " & _
                     "WMS_INV_RATES.INVR_DESC AS INVD_DESC, " & _
                     "'' AS INVD_ITM_CODE, '' AS INVD_PACK_KEY,  WMS_INV_RATES.INVR_LOC AS INVD_LOC, " & _
                     "null as INVD_TX_DATE, MAX(WMS_INV_RATES.INVR_UNIT) AS INVD_UNIT, " & _
                     "MAX(WMS_INV_RATES.INVR_RATE) AS INVD_RATE, " & _
                     "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN BAL_TX.ITX_BAL_CBM ELSE " & _
                     "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN BAL_TX.ITX_BAL_KG END END AS INVD_QTY, " & _
                     "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN MAX(WMS_INV_RATES.INVR_RATE) * BAL_TX.ITX_BAL_CBM ELSE " & _
                     "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN MAX(WMS_INV_RATES.INVR_RATE) * BAL_TX.ITX_BAL_KG END END AS INVD_AMOUNT, " & _
                     "WMS_INV_RATES.INVR_CURR AS INVD_CURR, 'N' AS mFlag " & _
                    "FROM WMS_INV_RATES LEFT OUTER JOIN " & _
                     "(SELECT IMP_CODE, STORER_CODE, ITX_LOC, convert(varchar, ITX_DATE,103) AS ITX_DATE, SUM(ITX_BAL_CBM) AS ITX_BAL_CBM, SUM(ITX_BAL_KG) AS ITX_BAL_KG " & _
                      "FROM WMS_ITEM_LOC_BAL_TX " & _
                      "WHERE ITM_CODE IS NOT NULL " & _
                      "AND IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                      "AND STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                      "AND ITX_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                      "AND ITX_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
                      "GROUP BY IMP_CODE, STORER_CODE, ITX_LOC,convert(varchar, ITX_DATE,103)) BAL_TX " & _
                    "ON WMS_INV_RATES.IMP_CODE = BAL_TX.IMP_CODE " & _
                    "AND WMS_INV_RATES.STORER_CODE = BAL_TX.STORER_CODE " & _
                    "WHERE WMS_INV_RATES.INVR_TYPE IN ('BYCBM', 'BYWGT') " & _
                    "AND Getdate() >= WMS_INV_RATES.INVR_EFF_DATE " & _
                    "AND Getdate() < DATEADD(Day, 1, WMS_INV_RATES.INVR_EXP_DATE) " & _
                    "AND CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYCBM' THEN BAL_TX.ITX_BAL_CBM ELSE " & _
                    "CASE WHEN WMS_INV_RATES.INVR_TYPE = 'BYWGT' THEN BAL_TX.ITX_BAL_KG END END > 0 " & _
                    "AND WMS_INV_RATES.INVR_LOC = BAL_TX.ITX_LOC " & _
                    "AND WMS_INV_RATES.IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                    "AND WMS_INV_RATES.STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                    "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                    "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_INV_RATES.STORER_CODE, WMS_INV_RATES.INVR_TYPE, " & _
                    "WMS_INV_RATES.INVR_DESC, WMS_INV_RATES.INVR_CURR, WMS_INV_RATES.INVR_LOC, " & _
                    "BAL_TX.ITX_BAL_CBM, BAL_TX.ITX_BAL_KG " & _
                    "ORDER BY 8 "

        byCBMKG = gDB.getDataTable(byCBMKGSQL)

        Dim intxSQL As String = ""
        Dim outtxSQL As String = ""

        Dim inTxDT As New DataTable
        Dim outTxDT As New DataTable

        intxSQL = "SELECT DISTINCT GR_CODE, convert(varchar, GR_POSTED_DATE,103) AS GR_POSTED_DATE, GR_POSTED_BY " & _
          "FROM WMS_GOODSRCV " & _
          "WHERE GR_STATUS = 'POSTED' " & _
          "AND IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
          "AND STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
          "AND GR_POSTED_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
          "AND GR_POSTED_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
          "ORDER BY GR_POSTED_DATE "

        outtxSQL = "SELECT DISTINCT DO_CODE, convert(varchar, DO_POSTED_DATE,103) AS DO_POSTED_DATE, DO_POSTED_BY " & _
                    "FROM WMS_DELV_ORDER " & _
                    "WHERE DO_STATUS = 'POSTED' " & _
                    "AND IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                    "AND STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                    "AND DO_POSTED_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                    "AND DO_POSTED_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
                    "ORDER BY DO_POSTED_DATE "

        inTxDT = gDB.getDataTable(intxSQL)
        outTxDT = gDB.getDataTable(outtxSQL)

        If inTxDT.Rows.Count > 0 Then
            Dim iQTY As Decimal = 0
            Dim idateRange As String = ""

            iQTY = inTxDT.Rows.Count

            If inTxDT.Rows.Count = 1 Then
                idateRange = " (" & inTxDT.Rows(0).Item("GR_POSTED_DATE").ToString & ")"
            ElseIf inTxDT.Rows.Count > 1 Then
