    Protected Sub listmode_SelectedIndexChanged(ByVal sender As Object, ByVal e As System.EventArgs) Handles listmode.SelectedIndexChanged
        If currentdt IsNot Nothing Then
            If cU.gfBuildDataTableforGridView(currentdt, GridView1, True) Then

                'dt.Merge(currentdt, True, MissingSchemaAction.Ignore)

                Dim tempInvSeq As String = ""
                Dim tempInvLoc As String = ""
                Dim tempInvdRate As Double = 0
                Dim tempInvdAmt As Double = 0

                Dim tempIndSEQ As String = ""

                For i As Integer = 0 To currentdt.Rows.Count - 1
                    tempInvSeq = gU.decodeNullOrEmpty(gU.dbEncode(currentdt.Rows(i).Item("INV_RATE_SEQ").ToString), "")
                    tempInvLoc = gU.decodeNullOrEmpty(gU.dbEncode(currentdt.Rows(i).Item("INVD_LOC").ToString.Replace("-", "")), "")
                    tempInvdRate = gU.decodeEmptyCdbl(gU.dbEncode(currentdt.Rows(i).Item("INVD_RATE").ToString), 0)
                    tempInvdAmt = gU.decodeEmptyCdbl(gU.dbEncode(currentdt.Rows(i).Item("INVD_AMOUNT").ToString), 0)

                    tempIndSEQ = gU.decodeNullOrEmpty(gU.dbEncode(currentdt.Rows(i).Item("INVD_SEQ").ToString.Replace("-", "")), "")

                    Dim dtlRows As DataRow() = dt.Select("INVD_SEQ = '" & tempIndSEQ & "'", _
                                                    "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")

                    For g As Integer = 0 To dtlRows.Count - 1
                        dtlRows(g).Item("INVD_RATE") = tempInvdRate.ToString
                        dtlRows(g).Item("INVD_AMOUNT") = tempInvdAmt.ToString
                        dtlRows(g).AcceptChanges()
                    Next

                    dt.AcceptChanges()

                    'Dim rateRows As DataRow() = dt.Select("INV_RATE_SEQ = '" & tempInvSeq & "' AND INVD_LOC = '" & tempInvLoc & "'", _
                    '                                      "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")

                    'For k As Integer = 0 To rateRows.Count - 1
                    '    rateRows(k).Item("INVD_RATE") = tempInvdRate.ToString
                    '    rateRows(k).AcceptChanges()
                    'Next

                    'dt.AcceptChanges()
                Next
            End If

            Dim tempRows As DataRow()
            Dim tempDT As New DataTable

            Select Case listmode.SelectedValue
                Case "DEFAULT"
                    ViewState("listmode") = "D"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='DEFAULT' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                Case "ITEM"
                    ViewState("listmode") = "I"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='ITEM' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                Case "LOCATION"
                    ViewState("listmode") = "L"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='LOCATION' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
                Case Else
                    ViewState("listmode") = "D"
                    tempRows = dt.Select("INVD_DISPLAY_GRP='DEFAULT' OR INVD_DISPLAY_GRP='ANY'", "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")
            End Select

            tempDT = dt.Copy
            tempDT.Rows.Clear()

            For x As Integer = 0 To tempRows.Count - 1
                tempDT.ImportRow(tempRows(x))
            Next

            GridView1.DataSource = tempDT
            ViewState("currentdt") = tempDT
            currentdt = tempDT

            ViewState("dt") = dt
            GridView1.DataBind()

            ar.sec_viewMode = "Y"

            ar.hideForm(Me, editMode, AddressOf page_customizectrl, AddressOf customizectrl)
            ar.hideGVForStorer(GridView1, STORER_CODE.Text, "INV", "WMS_INVOICE_DTL")
        End If
    End Sub
End Class
