                    "'' AS INVD_SEQ, " & _
                    "MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INVD_DISPLAY_SEQ, MAX(WMS_INV_RATES.INV_DISPLAY_SEQ) AS INV_DISPLAY_SEQ, " & _
                    "WMS_INV_RATES.INVR_TYPE AS INVD_TYPE, WMS_INV_RATES.INVR_DESC AS INVD_DESC, " & _
                    "'' AS INVD_ITM_CODE, '' AS INVD_PACK_KEY, '' AS INVD_LOC, " & _
                    "BAL_TX.ITX_DATE as INVD_TX_DATE, " & _
                    "MAX(WMS_INV_RATES.INVR_UNIT) AS INVD_UNIT, " & _
                    "MAX(WMS_INV_RATES.INVR_RATE) AS INVD_RATE, " & _
                    "BAL_TX.ITX_BAL_KG AS INVD_QTY, " & _
                    "MAX(WMS_INV_RATES.INVR_RATE) * BAL_TX.ITX_BAL_KG AS INVD_AMOUNT, " & _
                    "WMS_INV_RATES.INVR_CURR AS INVD_CURR, 'N' AS mFlag " & _
                    "FROM WMS_INV_RATES LEFT OUTER JOIN " & _
                        "(SELECT IMP_CODE, STORER_CODE, convert(varchar, ITX_DATE,103) AS ITX_DATE, SUM(ITX_BAL_KG) as ITX_BAL_KG , ITX_LOC " & _
                        "FROM WMS_ITEM_LOC_BAL_TX WHERE " & _
                        "WMS_ITEM_LOC_BAL_TX.IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                        "AND WMS_ITEM_LOC_BAL_TX.STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                        "AND convert(varchar, ITX_DATE,103) = (SELECT convert(varchar, MAX(ITX_DATE),103) from " & _
                                                                "WMS_ITEM_LOC_BAL_TX WHERE ITX_DATE >= convert(datetime, '" & gU.dbEncode(frm_date) & "',103) " & _
                                                                "AND ITX_DATE < DATEADD(DAY, 1, convert(datetime, '" & gU.dbEncode(to_date) & "',103)) " & _
                                                                "AND IMP_CODE = '" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                                                                "AND STORER_CODE = '" & gU.dbEncode(STORER_CODE.SelectedValue) & "' " & _
                                                                "AND ITX_BAL_KG > 0) " & _
                        "AND ITM_CODE IS NOT NULL " & _
                        "AND ITX_BAL_KG > 0 " & _
                        "GROUP BY IMP_CODE, STORER_CODE, convert(varchar, ITX_DATE,103), ITX_LOC) BAL_TX " & _
                    "ON WMS_INV_RATES.IMP_CODE = BAL_TX.IMP_CODE AND " & _
                    "WMS_INV_RATES.STORER_CODE = BAL_TX.STORER_CODE " & _
                    "WHERE WMS_INV_RATES.INVR_TYPE = 'BYKGAE' " & _
                    "AND Getdate() >= WMS_INV_RATES.INVR_EFF_DATE " & _
                    "AND Getdate() < DATEADD(Day, 1, WMS_INV_RATES.INVR_EXP_DATE) " & _
                    "AND BAL_TX.ITX_BAL_KG > 0 " & _
                    "AND WMS_INV_RATES.INVR_LOC = BAL_TX.ITX_LOC " & _
                    "AND WMS_INV_RATES.INVR_STATUS = 'ACTIVE' " & _
                    "GROUP BY WMS_INV_RATES.IMP_CODE, WMS_INV_RATES.STORER_CODE, " & _
                    "WMS_INV_RATES.INVR_TYPE,WMS_INV_RATES.INVR_DESC, " & _
                    "BAL_TX.ITX_DATE, WMS_INV_RATES.INVR_LOC, " & _
                    "WMS_INV_RATES.INVR_CURR,BAL_TX.ITX_BAL_KG " & _
                    "ORDER BY 8"

        cbmas = gDB.getDataTable(cbmasSQL)
        cbmae = gDB.getDataTable(cbmaeSQL)
        kgas = gDB.getDataTable(kgasSQL)
        kgae = gDB.getDataTable(kgaeSQL)

        dailyDT.Dispose()

        refDT.Merge(cbmas, True, MissingSchemaAction.Ignore)
        refDT.Merge(cbmae, True, MissingSchemaAction.Ignore)
        refDT.Merge(kgas, True, MissingSchemaAction.Ignore)
        refDT.Merge(kgae, True, MissingSchemaAction.Ignore)
        refDT.Merge(oneTimeDT, True, MissingSchemaAction.Ignore)

        Return refDT
    End Function

