    Private Function validateAll() As Boolean
        Dim selectSql As String = ""
        Dim i As Integer

        If STORER_CODE.SelectedValue = "" Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", lbl_STORER_CODE.Text & " cannot be empty!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", lbl_STORER_CODE.Text & "不能空白!", Session("gLang"))
            End If
            Return False
        End If

        If INVH_DATE.Text.Trim = "" Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", lbl_INVH_DATE.Text & " cannot be empty!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", lbl_INVH_DATE.Text & "不能空白!", Session("gLang"))
            End If
            Return False
        ElseIf Not gU.isValidDate(INVH_DATE.Text.Trim) Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", "Invalid date, " & lbl_INVH_DATE.Text & "!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", "無效的日期, " & lbl_INVH_DATE.Text & "!", Session("gLang"))
            End If
            Return False
        End If

        If INVH_FR_MONTH.Text.Trim = "" Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", lbl_INVH_FR_MONTH.Text & " cannot be empty!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", lbl_INVH_FR_MONTH.Text & "不能空白!", Session("gLang"))
            End If
            Return False
        ElseIf Not gU.isValidDate(INVH_FR_MONTH.Text.Trim) Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", "Invalid date, " & lbl_INVH_FR_MONTH.Text & "!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", "無效的日期, " & lbl_INVH_FR_MONTH.Text & "!", Session("gLang"))
            End If
            Return False
        End If

        If INVH_TO_MONTH.Text.Trim = "" Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", lbl_INVH_TO_MONTH.Text & " cannot be empty!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", lbl_INVH_TO_MONTH.Text & "不能空白!", Session("gLang"))
            End If
            Return False
        ElseIf Not gU.isValidDate(INVH_TO_MONTH.Text.Trim) Then
            If Session("gLang") = "E" Then
                uiFun.displayMsg(Me, "", "Invalid date, " & lbl_INVH_TO_MONTH.Text & "!", Session("gLang"))
            Else
                uiFun.displayMsg(Me, "", "無效的日期, " & lbl_INVH_TO_MONTH.Text & "!", Session("gLang"))
            End If
            Return False
        End If

        Return True

    End Function

    Protected Sub save(Optional ByVal flag As String = "")
        Dim alertstr As String = ""
        Dim sql_string As String = ""
        Dim itemSQL As String = ""
        Dim nextNo As String = ""
        Dim gConn As SqlConnection
        Dim dupSQL As String = ""
        Dim dupTbl As New DataTable

        Dim varQty As Double = 0

        If ViewState("old_fr") <> "" OrElse ViewState("old_to") <> "" Then
            If ViewState("old_fr") <> INVH_FR_MONTH.Text OrElse ViewState("old_to") <> INVH_TO_MONTH.Text Then
                ViewState("genbeforesave") = True
            End If
        End If

        If ViewState("genbeforesave") = True Then
            uiFun.displayMsg(Me, "", "Date range is changed, please Generate Invoice once again before you save!", Session("gLang"))
            Exit Sub
        End If

        If validateAll() Then

            gConn = gDB.getConnection()

            Dim transaction As SqlTransaction
            transaction = gConn.BeginTransaction()
            ' Start a local transaction
            Try
                If Session("pagemode") = "N" Then
                    REM **********************
                    REM Modify Here

                    nextNo = DB.getDocNo("INV", gConn, transaction)

                    REM **********************

                    dupSQL = "select 1 from WMS_INVOICE_HD " & _
                                "where invh_no = '" & gU.dbEncode(nextNo) & "' " & _
                                "and imp_code='" & gU.dbEncode(Session("IMP_CODE")) & "' " & _
                                "and storer_code='" & gU.dbEncode(STORER_CODE.SelectedValue) & "' "

                    dupTbl = gDB.getDataTable(dupSQL)

                    REM **********************
                    REM Modify Here
                    REM char "N" is use for update Unicode
                    If dupTbl.Rows.Count = 0 Then
                        sql_string = "insert into wms_invoice_hd " & _
                        "(invh_no, imp_code,storer_code, " & _
                        "invh_date,invh_fr_month, invh_to_month, " & _
                        "invh_gen_by, cus_code, cus_name, " & _
                        "invh_addr1, invh_addr2, invh_addr3, " & _
                        "invh_attn,invh_tel,invh_fax, " & _
                         "sys_cb, sys_cd, sys_lub, sys_lud)" & _
                        "values ( " & _
                        gU.convdbNVCData(gU.dbEncode(nextNo)) & "," & gU.convdbNVCData(gU.dbEncode(Session("IMP_CODE"))) & "," & gU.convdbNVCData(gU.dbEncode(STORER_CODE.SelectedValue)) & "," & _
                        gU.convdbDate(gU.dbEncode(INVH_DATE.Text.Trim)) & "," & gU.convdbDate(gU.dbEncode(INVH_FR_MONTH.Text.Trim)) & "," & gU.convdbDate(gU.dbEncode(INVH_TO_MONTH.Text.Trim)) & "," & _
                        gU.convdbNVCData(gU.dbEncode(INVH_GEN_BY.Text.Trim)) & "," & gU.convdbNVCData(gU.dbEncode(CUS_CODE.SelectedValue)) & "," & gU.convdbNVCData(gU.dbEncode(CUS_NAME.Text.Trim)) & "," & _
                        gU.convdbNVCData(gU.dbEncode(INVH_ADDR1.Text.Trim)) & "," & gU.convdbNVCData(gU.dbEncode(INVH_ADDR2.Text.Trim)) & "," & gU.convdbNVCData(gU.dbEncode(INVH_ADDR3.Text.Trim)) & "," & _
                        gU.convdbNVCData(gU.dbEncode(INVH_ATTN.Text.Trim)) & "," & gU.convdbNVCData(gU.dbEncode(INVH_TEL.Text.Trim)) & "," & gU.convdbNVCData(gU.dbEncode(INVH_FAX.Text.Trim)) & "," & _
                         "'" & Session("usr_id") & "',Getdate(),'" & Session("usr_id") & "',Getdate()) "

                        REM **********************

                        'If cU.gfBuildDataTableforGridView(dt, GridView1, True) Then
                        If Not currentdt Is Nothing AndAlso cU.gfBuildDataTableforGridView(currentdt, GridView1, True) Then
                            Dim tempInvdSeq As String = ""
                            Dim tempInvdRate As Double = 0
                            Dim tempInvdAmt As Double = 0

                            For i As Integer = 0 To currentdt.Rows.Count - 1
                                tempInvdRate = gU.decodeEmptyCdbl(gU.dbEncode(currentdt.Rows(i).Item("INVD_RATE").ToString), 0)
                                tempInvdAmt = gU.decodeEmptyCdbl(gU.dbEncode(currentdt.Rows(i).Item("INVD_AMOUNT").ToString), 0)
                                tempInvdSeq = gU.decodeNullOrEmpty(gU.dbEncode(currentdt.Rows(i).Item("INVD_SEQ").ToString.Replace("-", "")), "")

                                Dim dtlRows As DataRow() = dt.Select("INVD_SEQ = '" & tempInvdSeq & "'", _
                                                                "INVD_DISPLAY_SEQ,INVD_TX_DATE,INVD_ITM_CODE,INVD_PACK_KEY")

                                For g As Integer = 0 To dtlRows.Count - 1
                                    dtlRows(g).Item("INVD_RATE") = tempInvdRate.ToString
                                    dtlRows(g).Item("INVD_AMOUNT") = tempInvdAmt.ToString
                                    dtlRows(g).AcceptChanges()
                                Next

                                dt.AcceptChanges()
                            Next

                            uiFun.reOrderDetails(dt, "INVD_DISPLAY_SEQ")

                            For Each rows As DataRow In dt.Rows
                                itemSQL = ""

                                REM **********************
                                REM Modify Here
                                Select Case rows.Item("mFlag")
                                    Case "N"
                                        itemSQL = "insert into wms_invoice_dtl " & _
                                                "(invh_no, imp_code,storer_code, " & _
                                                "invd_seq,invd_display_seq,invd_itm_code, invd_pack_key, " & _
                                                "invd_type,invd_desc,invd_unit," & _
                                                "invd_rate, invd_curr, invd_qty, invd_amount, " & _
                                                "invd_tx_date, invd_loc, invd_display_grp, inv_rate_seq, " & _
                                                "sys_cb, sys_cd, sys_lub, sys_lud) " & _
                                                "values (" & _
                                                gU.convdbNVCData(gU.dbEncode(nextNo)) & "," & gU.convdbNVCData(gU.dbEncode(Session("IMP_CODE"))) & "," & gU.convdbNVCData(gU.dbEncode(STORER_CODE.SelectedValue)) & ", " & _
                                                gU.convdbNVCData(gU.dbEncode(gU.decodeNull(rows.Item("invd_seq").ToString.Trim, ""))) & ", " & _
                                                gU.dbEncode(gU.decodeNullOrEmpty(rows.Item("invd_display_seq").ToString.Trim, "0")) & ", " & _
                                                gU.convdbNVCData(gU.dbEncode(gU.decodeNull(rows.Item("invd_itm_code").ToString.Trim.Replace("-", ""), ""))) & ", " & _
                                                gU.convdbNVCData(gU.dbEncode(gU.decodeNull(rows.Item("invd_pack_key").ToString.Trim.Replace("-", ""), ""))) & ", " & _
                                                gU.convdbNVCData(gU.dbEncode(gU.decodeNull(rows.Item("invd_type").ToString.Trim, ""))) & ", " & _
                                                gU.convdbNVCData(gU.dbEncode(gU.decodeNull(rows.Item("invd_desc").ToString.Trim, ""))) & ", " & _
                                                gU.convdbNVCData(gU.dbEncode(gU.decodeNull(rows.Item("invd_unit").ToString.Trim.Replace("-", ""), ""))) & ", " & _
                                                gU.dbEncode(gU.decodeNullOrEmpty(rows.Item("invd_rate").ToString.Trim, "0")) & ", " & _
