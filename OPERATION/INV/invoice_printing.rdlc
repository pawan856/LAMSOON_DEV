      <Query>
        <DataSourceName>WMS_DEVConnectionString</DataSourceName>
        <CommandText>select   WMS_INVOICE_HD.IMP_CODE, WMS_INVOICE_HD.STORER_CODE, WMS_INVOICE_HD.INVH_NO, WMS_INVOICE_HD.INVH_DATE, 
                         WMS_INVOICE_HD.INVH_FR_MONTH, WMS_INVOICE_HD.INVH_TO_MONTH, WMS_INVOICE_HD.INVH_GEN_BY, WMS_INVOICE_HD.CUS_CODE, 
                         WMS_INVOICE_HD.CUS_NAME, WMS_INVOICE_HD.INVH_ADDR1, WMS_INVOICE_HD.INVH_ADDR2, WMS_INVOICE_HD.INVH_ADDR3, 
                         WMS_INVOICE_HD.INVH_ATTN, WMS_INVOICE_HD.INVH_TEL, WMS_INVOICE_HD.INVH_FAX, WMS_INVOICE_HD.SYS_CB, WMS_INVOICE_HD.SYS_CD, 
                         WMS_INVOICE_HD.SYS_LUB, WMS_INVOICE_HD.SYS_LUD, WMS_INVOICE_DTL.INVD_SEQ, WMS_INVOICE_DTL.INVD_DISPLAY_SEQ, WMS_INVOICE_DTL.INVD_ITM_CODE, 
                         WMS_INVOICE_DTL.INVD_PACK_KEY, WMS_INVOICE_DTL.INVD_TYPE, WMS_INVOICE_DTL.INVD_DESC, WMS_INVOICE_DTL.INVD_UNIT, 
                         WMS_INVOICE_DTL.INVD_RATE, WMS_INVOICE_DTL.INVD_CURR, WMS_INVOICE_DTL.INVD_QTY, WMS_INVOICE_DTL.INVD_AMOUNT
 from WMS_INVOICE_HD INNER JOIN WMS_INVOICE_DTL ON
WMS_INVOICE_HD.IMP_CODE = WMS_INVOICE_DTL.IMP_CODE AND
WMS_INVOICE_HD.STORER_CODE = WMS_INVOICE_DTL.STORER_CODE AND
WMS_INVOICE_HD.INVH_NO = WMS_INVOICE_DTL.INVH_NO</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <rd:DataSetInfo>
        <rd:DataSetName>rptDataSet</rd:DataSetName>
        <rd:TableName>inv_printout</rd:TableName>
        <rd:TableAdapterFillMethod>Fill</rd:TableAdapterFillMethod>
        <rd:TableAdapterGetDataMethod>GetData</rd:TableAdapterGetDataMethod>
        <rd:TableAdapterName>inv_printoutTableAdapter</rd:TableAdapterName>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
