# ==============================================
# Visual Studio / .NET Core .gitignore
# ==============================================

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/

# Rider / JetBrains
.idea/
*.iml

# Visual Studio Code
.vscode/
.history/

# Visual Studio
.vs/
.vscode/
*.vspscc
*_i.c
*_p.c
*_h.h
*.dbmdl
*.bak
*.Backup
*.FileListAbsolute.txt
*.tlog
*.vsidx

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Node.js / Frontend (if applicable)
node_modules/
dist/
build/
npm-debug.log
yarn-debug.log
yarn-error.log
package-lock.json
*.tsbuildinfo

# Publish output
publish/
out/
*.Publish.xml

# Environment and secrets
.env
.env.*
appsettings.Development.json
appsettings.Local.json
appsettings.Secret.json
appsettings.*.local.json

# Logs
*.log
logs/
log/

# Temporary files
*.tmp
*.temp
*.cache
*.bak

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
Desktop.ini

# ==============================================
# Optional: Git Large File Storage (Git LFS)
# ==============================================
# Track big binary files if you use them
# *.zip filter=lfs diff=lfs merge=lfs -text
# *.exe filter=lfs diff=lfs merge=lfs -text
# *.dll filter=lfs diff=lfs merge=lfs -text
